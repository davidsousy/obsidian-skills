# Supabase (local: `npm run db:start`; produção: Project Settings → API Keys)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Só no servidor (cron de alertas). Nunca expor no cliente.
SUPABASE_SECRET_KEY=

# Alertas por e-mail (Vercel Cron chama /api/cron/alertas com "Authorization: Bearer $CRON_SECRET")
CRON_SECRET=
RESEND_API_KEY=
ALERT_FROM_EMAIL="Finanças da Casa <alertas@seudominio.com.br>"
APP_URL=https://seu-app.vercel.app

# Só para os testes de banco (RLS)
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
